NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
NEXT_PUBLIC_SITE_URL=
# Match this to the CRON_SECRET GitHub Actions secret; use a long random value.
CRON_SECRET=
# Admin-triggered backups require a fine-grained GitHub token with Actions: write permission.
GITHUB_ACTIONS_TOKEN=
# GitHub repository that contains .github/workflows/database-backup.yml (owner/repository).
GITHUB_REPOSITORY=
GITHUB_BACKUP_REF=main
